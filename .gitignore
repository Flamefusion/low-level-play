# Added by Cargo
# Ref: https://doc.rust-lang.org/cargo/reference/cargo-targets.html

# Compiled binaries and target directory
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which contain debugging symbols
*.pdb

# --- IDEs and Editors ---
# JetBrains IDEs: .idea/
.idea/
*.iml

# VS Code: .vscode/ (except launch.json/settings.json if shared, but usually ignored)
.vscode/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim swap files
[._]*.s[a-v][a-z]
!*.svg
[._]*.un~
Session.vim
.netrwhist

# --- OS Metadata ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
